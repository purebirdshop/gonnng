{
  "info": {
    "_postman_id": "a9876543-210b-4cde-8901-fedcba987654",
    "name": "Application Service Layer Test Suite",
    "description": "Comprehensive Postman test automation collection for API service layer verification including authentication, user sessions, health, and metadata endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains status ok', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "});",
              "pm.test('Response time is under 500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Cookie Governance",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns cookie standards and category disclosures', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('cookies');",
              "    pm.expect(jsonData.cookies).to.be.an('array');",
              "    var sessionCookie = jsonData.cookies.find(c => c.name === 'gonnng_session');",
              "    pm.expect(sessionCookie).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cookie-governance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cookie-governance"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. User Registration",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// TC-003: User registration disabled/skipped during automated suite runs",
              "// to avoid generating transient test accounts in the database.",
              "postman.setNextRequest('4. User Login');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test.skip('TC-003: User Registration (Skipped in automated suite to prevent test account creation)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"QA Tester\",\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. User Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns authentication confirmation and user profile', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.authenticated).to.be.true;",
              "    pm.expect(jsonData).to.have.property('user');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"rememberMe\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Get Current Session User (/api/auth/me)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Validates session user schema', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.authenticated).to.be.true;",
              "    pm.expect(jsonData.user).to.have.property('goals');",
              "    pm.expect(jsonData.user.email).to.eql(pm.environment.get('testEmail'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "response": []
    },
