# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Integration (Database & Storage)
VITE_ENABLE_SUPABASE="false"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Resend Transactional Email Service
VITE_RESEND_API_KEY=""

# Authentication Feature Flag
VITE_ENABLE_AUTH="true"

# File Upload Feature Flag
VITE_ENABLE_FILE_UPLOADS="true"

# SFTP RESTful Cloud Storage Service Configuration
ENABLE_SFTP_STORAGE="true"
SFTP_HOST=""
SFTP_PORT="22"
SFTP_USERNAME=""
SFTP_PASSWORD=""
SFTP_PRIVATE_KEY=""
SFTP_REMOTE_PATH="/uploads"
